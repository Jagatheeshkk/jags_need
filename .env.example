# Local development configuration. Copy to .env and fill in. Never commit .env.
# Generate random values in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Docker Compose PostgreSQL ---
POSTGRES_USER=aja
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=aja
# Host port for connecting from Windows tools; change if 5432 is already in use.
POSTGRES_HOST_PORT=5432
# Host ports for the API and web app (change if already in use).
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Backend ---
# Signs session cookies (min 32 chars).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Optional locally. When set, it is required to create the owner account.
BOOTSTRAP_TOKEN=

# rule_based (default, no API key, no cost) or ollama (optional local model).
AI_PROVIDER=rule_based
OLLAMA_BASE_URL=http://host.docker.internal:11434
