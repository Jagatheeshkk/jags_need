# Production configuration template. Set these as environment variables in the hosting
# dashboards (Render for the API, Vercel for the web app). Never commit real values.

# ===== Render (API web service) =====
ENVIRONMENT=production
# Neon connection string (use the pooled "-pooler" host). sslmode=require is mandatory.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# 48+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Random value you type once on the setup screen to create the owner account.
BOOTSTRAP_TOKEN=
# Your Vercel URL. Normal traffic is same-origin through the Vercel /api proxy.
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
AI_PROVIDER=rule_based
DB_POOL_SIZE=3

# ===== Vercel (web) =====
# Server-side only (no NEXT_PUBLIC_ prefix): used by the /api rewrite at build time.
BACKEND_URL=https://YOUR-SERVICE.onrender.com
NEXT_TELEMETRY_DISABLED=1
